from datetime import datetime
from collections import Counter

# ------------------------------------------------------------
# DATA STORAGE
# ------------------------------------------------------------

registrations = []


# ------------------------------------------------------------
# REGISTER STUDENT
# ------------------------------------------------------------

def register_student():
    print("\n" + "=" * 55)
    print("        COLLEGE EVENT REGISTRATION")
    print("=" * 55)

    name = input("Student Name       : ").strip()
    reg_no = input("Register Number    : ").strip()
    department = input("Department         : ").strip().upper()
    year = input("Year (1/2/3/4)     : ").strip()
    event = input("Event Name         : ").strip()
    participation = input(
        "Participation Type (Participant/Volunteer/Organizer): "
    ).strip().title()
    contact = input("Contact Details    : ").strip()

    # Validation
    if not name or not reg_no or not department or not event or not contact:
        print("\nERROR: All fields are required.")
        return

    if year not in ["1", "2", "3", "4"]:
        print("\nERROR: Year must be 1, 2, 3 or 4.")
        return

    valid_types = ["Participant", "Volunteer", "Organizer"]

    if participation not in valid_types:
        print("\nERROR: Invalid participation type.")
        return

    # Duplicate registration check
    for record in registrations:
        if (record["Register Number"] == reg_no and
                record["Event Name"].lower() == event.lower() and
                record["Registration Status"] != "Cancelled"):

            print("\nERROR: Student is already registered for this event.")
            return

    # Create registration record
    record = {
        "Student Name": name,
        "Register Number": reg_no,
        "Department": department,
        "Year": year,
        "Event Name": event,
        "Participation Type": participation,
        "Contact Details": contact,
        "Registration Date": datetime.now().strftime("%d-%m-%Y %H:%M:%S"),
        "Registration Status": "Registered"
    }

    registrations.append(record)

    print("\nRegistration successful!")
    print("Registration Date :", record["Registration Date"])
    print("Status             :", record["Registration Status"])


# ------------------------------------------------------------
# DISPLAY ALL REGISTRATIONS
# ------------------------------------------------------------

def display_registrations():

    print("\n" + "=" * 120)
    print("                    ALL REGISTRATIONS")
    print("=" * 120)

    if not registrations:
        print("No registrations available.")
        return

    for i, r in enumerate(registrations, start=1):

        print(f"\nRegistration #{i}")
        print("-" * 50)

        for key, value in r.items():
            print(f"{key:<22}: {value}")


# ------------------------------------------------------------
# TOTAL REGISTRATIONS
# ------------------------------------------------------------

def total_registrations():

    total = len([
        r for r in registrations
        if r["Registration Status"] != "Cancelled"
    ])

    print("\n" + "=" * 55)
    print("              TOTAL REGISTRATIONS")
    print("=" * 55)

    print(f"\nTotal Registrations : {total}")


# ------------------------------------------------------------
# EVENT-WISE REGISTRATIONS
# ------------------------------------------------------------

def event_wise_report():

    print("\n" + "=" * 55)
    print("             EVENT-WISE REGISTRATIONS")
    print("=" * 55)

    active = [
        r for r in registrations
        if r["Registration Status"] != "Cancelled"
    ]

    if not active:
        print("\nNo registration data available.")
        return

    event_count = Counter(
        r["Event Name"] for r in active
    )

    for event, count in event_count.most_common():

        print(f"{event:<30} : {count}")


