# ------------------------------------------------------------
# MOST POPULAR EVENT
# ------------------------------------------------------------

def most_popular_event():

    print("\n" + "=" * 55)
    print("               MOST POPULAR EVENT")
    print("=" * 55)

    active = [
        r for r in registrations
        if r["Registration Status"] != "Cancelled"
    ]

    if not active:
        print("\nNo registration data available.")
        return

    event_count = Counter(
        r["Event Name"] for r in active
    )

    event, count = event_count.most_common(1)[0]

    print(f"\nMost Popular Event : {event}")
